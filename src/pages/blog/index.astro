---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts, getSiteSettings } from "@/lib/content/api";
const [siteSettings, posts] = await Promise.all([
  getSiteSettings(),
  getPublishedPosts(),
]);
---

<BaseLayout
  siteSettings={siteSettings}
  title={`Blog | ${siteSettings.siteTitle}`}
  description="ペットシッターの活動報告とお知らせの記事一覧です。"
  canonicalPath="/blog/"
>
  <section class="page-header">
    <p class="eyebrow">Entries / all</p>
    <h1>記事一覧</h1>
    <p>
      日々のシッティングの様子や、サービスに関するお知らせを掲載しています。
    </p>
  </section>
  {
    posts.length > 0 ? (
      <div class="stack">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="empty-state">公開済みの記事はまだありません。</p>
    )
  }
</BaseLayout>
