---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import TagPill from "@/components/TagPill.astro";
import {
  getCategories,
  getPublishedPosts,
  getSiteSettings,
} from "@/lib/content/api";

const [siteSettings, posts, categories] = await Promise.all([
  getSiteSettings(),
  getPublishedPosts(),
  getCategories(),
]);
const recentPosts = posts.slice(0, 5);
---

<BaseLayout siteSettings={siteSettings}>
  <section class="hero">
    <p class="eyebrow">Pet sitter / daily reports</p>
    <h1>{siteSettings.siteTagline}</h1>
    <p>
      {siteSettings.defaultSeoDescription} シッティングの様子やサービスについて、日々の報告をお届けします。
    </p>
    <div class="hero__actions">
      <a class="button" href="/blog/"
        >記事を読む <span aria-hidden="true">→</span></a
      >
      <a class="button button--ghost" href="/about/">このブログについて</a>
    </div>
  </section>

  {
    categories.length > 0 && (
      <nav class="tag-index" aria-label="カテゴリーから記事を探す">
        <span class="tag-index__label">CATEGORIES</span>
        <div class="tag-index__items">
          {categories.map((category) => (
            <TagPill href={`/tags/${category.slug}/`} label={category.name} />
          ))}
        </div>
      </nav>
    )
  }

  <section class="entries-section" aria-labelledby="recent-entries">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Activity reports</p><h2 id="recent-entries">
          活動報告
        </h2>
      </div>
      <a href="/blog/">すべて見る <span aria-hidden="true">→</span></a>
    </div>
    {
      recentPosts.length > 0 ? (
        <div class="stack">
          {recentPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="empty-state">公開済みの記事はまだありません。</p>
      )
    }
  </section>
</BaseLayout>
