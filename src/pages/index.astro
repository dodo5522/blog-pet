---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import {
  getCategories,
  getPublishedPosts,
  getSiteSettings,
} from "@/lib/content/api";
import { splitTextParagraphs } from "@/lib/content/textParagraphs";

const [siteSettings, posts, categories] = await Promise.all([
  getSiteSettings(),
  getPublishedPosts(),
  getCategories(),
]);
const recentPosts = posts.slice(0, 3);
const introductionParagraphs = splitTextParagraphs(
  siteSettings.defaultSeoDescription,
);
if (introductionParagraphs.length > 0) {
  introductionParagraphs[introductionParagraphs.length - 1] +=
    " 大切な家族がいつもの場所で安心して過ごせるよう、日々の活動やサービスをご紹介します。";
} else {
  introductionParagraphs.push(
    "大切な家族がいつもの場所で安心して過ごせるよう、日々の活動やサービスをご紹介します。",
  );
}
---

<BaseLayout siteSettings={siteSettings}>
  <section class="hero hero--home">
    <div class="hero__copy">
      <h1>{siteSettings.siteTagline}</h1>
      <div class="hero__introduction">
        {introductionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="hero__actions">
        <a class="button" href="/usage/"
          >ご利用方法を見る <span aria-hidden="true">→</span></a
        >
        <a class="button button--ghost" href="/contact/">お問い合わせ</a>
      </div>
    </div>
    <figure class="hero__visual">
      <img
        class="hero__image"
        src="/images/cat-window-light.webp"
        alt="日差しの入る部屋でくつろぐ猫のイメージ"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </section>

  <section class="service-overview" aria-labelledby="service-overview-title">
    <div class="section-heading">
      <div>
        <h2 id="service-overview-title">サービスのご案内</h2>
      </div>
    </div>
    <div class="service-links">
      <a class="service-link" href="/usage/"
        ><strong>ご利用方法</strong><span aria-hidden="true">→</span></a
      >
      <a class="service-link" href="/price/"
        ><strong>料金</strong><span aria-hidden="true">→</span></a
      >
      <a class="service-link" href="/staff/"
        ><strong>スタッフ</strong><span aria-hidden="true">→</span></a
      >
      <a class="service-link" href="/access/"
        ><strong>対応エリア</strong><span aria-hidden="true">→</span></a
      >
    </div>
  </section>

  <section class="entries-section" aria-labelledby="recent-entries">
    <div class="section-heading">
      <div>
        <h2 id="recent-entries">活動報告</h2>
      </div>
      <a href="/blog/">すべて見る <span aria-hidden="true">→</span></a>
    </div>
    {
      recentPosts.length > 0 ? (
        <div class="stack">
          {recentPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="empty-state">公開済みの記事はまだありません。</p>
      )
    }
  </section>

  {
    categories.length > 0 && (
      <section
        class="category-overview"
        aria-labelledby="category-overview-title"
      >
        <div class="section-heading">
          <div>
            <h2 id="category-overview-title">カテゴリー</h2>
          </div>
          <a href="/categories/">
            一覧を見る <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="category-cards">
          {categories.map((category) => (
            <a class="category-card" href={`/categories/${category.slug}/`}>
              <strong>{category.name}</strong>
              {category.description && <span>{category.description}</span>}
              <span class="category-card__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="contact-banner" aria-labelledby="contact-banner-title">
    <div>
      <h2 id="contact-banner-title">ご相談・お問い合わせ</h2>
      <p>
        サービスについて気になることがありましたら、お気軽にご相談ください。
      </p>
    </div>
    <a class="button" href="/contact/"
      >お問い合わせはこちら <span aria-hidden="true">→</span></a
    >
  </section>
</BaseLayout>
