---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories, getSiteSettings } from "@/lib/content/api";
const [siteSettings, categories] = await Promise.all([
  getSiteSettings(),
  getCategories(),
]);
---

<BaseLayout
  siteSettings={siteSettings}
  title={`カテゴリー一覧 | ${siteSettings.siteTitle}`}
  description="記事カテゴリーの一覧です。"
  canonicalPath="/tags/"
>
  <section class="page-header">
    <p class="eyebrow">Index / topics</p>
    <h1>カテゴリー一覧</h1>
    <p>カテゴリーから、関連する活動報告やお知らせを探せます。</p>
  </section>
  {
    categories.length > 0 ? (
      <ul class="tag-list">
        {categories.map((category) => (
          <li class="tag-list__item">
            <a href={`/tags/${category.slug}/`}>
              <span class="tag-list__arrow" aria-hidden="true">
                →
              </span>
              <strong>{category.name}</strong>
              {category.description && <span>{category.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">カテゴリーはまだありません。</p>
    )
  }
</BaseLayout>
