---
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getCategories,
  getPostsByCategorySlug,
  getSiteSettings,
} from "@/lib/content/api";

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { slug: category.slug } }));
}

const { slug } = Astro.params;
const [siteSettings, categories, posts] = await Promise.all([
  getSiteSettings(),
  getCategories(),
  getPostsByCategorySlug(slug || ""),
]);
const category = categories.find((entry) => entry.slug === slug);
if (!category) return Astro.redirect("/404.html");
---

<BaseLayout
  siteSettings={siteSettings}
  title={`${category.name} | ${siteSettings.siteTitle}`}
  description={category.description || `${category.name} に関連する記事一覧`}
  canonicalPath={`/categories/${category.slug}/`}
>
  <section class="page-header">
    <p class="eyebrow">Category</p>
    <h1>{category.name}</h1>
    <p>{category.description || `${category.name} に関連する公開記事です。`}</p>
  </section>
  {
    posts.length > 0 ? (
      <div class="stack">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="empty-state">
        このカテゴリーに紐づく公開記事はまだありません。
      </p>
    )
  }
</BaseLayout>
