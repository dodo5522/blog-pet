---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories, getSiteSettings } from "@/lib/content/api";

const [siteSettings, categories] = await Promise.all([
  getSiteSettings(),
  getCategories(),
]);
---

<BaseLayout
  siteSettings={siteSettings}
  title={`カテゴリー一覧 | ${siteSettings.siteTitle}`}
  description="活動報告やお知らせをカテゴリーから探せます。"
  canonicalPath="/categories/"
>
  <section class="page-header">
    <p class="eyebrow">Browse by topic</p>
    <h1>カテゴリー</h1>
    <p>活動報告やお知らせをカテゴリーからご覧いただけます。</p>
  </section>
  {
    categories.length > 0 ? (
      <ul class="category-list">
        {categories.map((category) => (
          <li class="category-list__item">
            <a href={`/categories/${category.slug}/`}>
              <strong>{category.name}</strong>
              <span>{category.description || "カテゴリーの記事を見る"}</span>
              <span class="category-list__arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">カテゴリーはまだありません。</p>
    )
  }
</BaseLayout>
