---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import type { SiteSettings } from "@/lib/content/types";
import { publicSiteUrl } from "@/lib/env";
import { firstNonBlank, selectSeoImage } from "@/lib/seo";
import { siteUrlFor } from "@/lib/siteUrl";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  imageUrl?: string;
  ogType?: "article" | "website";
  noindex?: boolean;
  siteSettings: SiteSettings;
}

const {
  title,
  description,
  canonicalPath = "/",
  imageUrl,
  ogType = "website",
  noindex = false,
  siteSettings,
} = Astro.props;
const pageTitle =
  firstNonBlank(title, siteSettings.defaultSeoTitle, siteSettings.siteTitle) ||
  siteSettings.siteTitle;
const pageDescription =
  firstNonBlank(description, siteSettings.defaultSeoDescription) || "";
const canonicalUrl = siteUrlFor(canonicalPath, publicSiteUrl);
const ogImage =
  firstNonBlank(imageUrl) || selectSeoImage(siteSettings.defaultOgImage);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf8f1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteSettings.siteTitle} RSS`}
      href={siteUrlFor("/rss.xml", publicSiteUrl)}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteSettings.siteTitle} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <SiteHeader title={siteSettings.siteTitle} />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter title={siteSettings.siteTitle} />
  </body>
</html>
